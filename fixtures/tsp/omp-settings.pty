lavender","label":"light-lavender"},{"value":"light-meadow","label":"light-meadow"},{"value":"light-mint","label":"light-mint"},{"value":"light-monochrome","label":"light-monochrome"},{"value":"light-ocean","label":"light-ocean"},{"value":"light-one","label":"light-one"},{"value":"light-opal","label":"light-opal"},{"value":"light-orchard","label":"light-orchard"},{"value":"light-paper","label":"light-paper"},{"value":"light-poimandres","label":"light-poimandres"},{"value":"light-prism","label":"light-prism"},{"value":"light-retro","label":"light-retro"},{"value":"light-sand","label":"light-sand"},{"value":"light-savanna","label":"light-savanna"},{"value":"light-solarized","label":"light-solarized"},{"value":"light-soleil","label":"light-soleil"},{"value":"light-sunset","label":"light-sunset"},{"value":"light-synthwave","label":"light-synthwave"},{"value":"light-tokyo-night","label":"light-tokyo-night"},{"value":"light-wetland","label":"light-wetland"},{"value":"light-zenith","label":"light-zenith"},{"value":"limestone","label":"limestone"},{"value":"mahogany","label":"mahogany"},{"value":"marble","label":"marble"},{"value":"obsidian","label":"obsidian"},{"value":"onyx","label":"onyx"},{"value":"pearl","label":"pearl"},{"value":"porcelain","label":"porcelain"},{"value":"quartz","label":"quartz"},{"value":"sandstone","label":"sandstone"},{"value":"titanium","label":"titanium"}],"style":"menu","mono":true}},{"id":"symbolPreset","label":"Symbol Preset","hint":"Glyph set for icons and symbols (Unicode, Nerd Font, or ASCII)","control":{"k":"choice","value":"unicode","options":[{"value":"unicode","label":"Unicode","detail":"Standard symbols (default)"},{"value":"nerd","label":"Nerd Font","detail":"Requires a Nerd Font, or a Glyph Protocol terminal (icons ship in-band)"},{"value":"ascii","label":"ASCII","detail":"Maximum compatibility"}],"style":"menu","mono":false}},{"id":"colorBlindMode","label":"Color-Blind Mode","hint":"Use blue instead of green for diff additions","control":{"k":"switch","on":false}}]},{"id":"composer","title":"Composer","rows":[{"id":"composer.shape","label":"Composer Shape","hint":"Visual layout of the input editor and status line","control":{"k":"choice","value":"band","options":[{"value":"band","label":"Status Band (Default)","detail":"Flush soft-capped status band above a curved prompt, no frame"},{"value":"box","label":"Rounded Box","detail":"Status line embedded in top border, compact 2-line prompt"},{"value":"claude","label":"Claude Code","detail":"Full-width horizontal rules above and below, status line at bottom"},{"value":"pi","label":"Pi","detail":"Framed horizontal rules with status line at bottom"},{"value":"borderless","label":"Borderless","detail":"Clean prompt glyph with status line at bottom, no box borders"},{"value":"rule","label":"Top Rule Dock","detail":"Single top rule with status docked onto it and below"},{"value":"field","label":"Compact Field","detail":"Filled one-row field with accent end caps"},{"value":"rail","label":"Accent Rail","detail":"Filled one-row field anchored by a single accent rail"}],"style":"menu","mono":false}},{"id":"composer.tokenRate","label":"Generation Rate","hint":"Show a live generation tok/s readout: on the working row next to the session title, or in the native composer bar right after the thinking level, where the last reading stays between turns. Estimated from streamed deltas and corrected by the provider's billed output count as each message completes.","control":{"k":"switch","on":false}}]},{"id":"status-line","title":"Status Line","rows":[{"id":"statusLine.preset","label":"Status Line Preset","hint":"Pre-built status line configurations","control":{"k":"choice","value":"default","options":[{"value":"default","label":"Default","detail":"Model, path, git, context, tokens, cost"},{"value":"minimal","label":"Minimal","detail":"Path and git only"},{"value":"compact","label":"Compact","detail":"Model, git, cost, context"},{"value":"full","label":"Full","detail":"All segments including time"},{"value":"nerd","label":"Nerd","detail":"Maximum info with Nerd Font icons"},{"value":"ascii","label":"ASCII","detail":"No special characters"},{"value":"custom","label":"Custom","detail":"User-defined segments"}],"style":"menu","mono":false}},{"id":"statusLine.separator","label":"Status Line Separator","hint":"Style of separators between segments","control":{"k":"choice","value":"powerline-thin","options":[{"value":"powerline","label":"Powerline","detail":"Solid arrows (Nerd Font)"},{"value":"powerline-thin","label":"Thin chevron","detail":"Thin arrows (Nerd Font)"},{"value":"slash","label":"Slash","detail":"Forward slashes"},{"value":"pipe","label":"Pipe","detail":"Vertical pipes"},{"value":"block","label":"Block","detail":"Solid blocks"},{"value":"none","label":"None","detail":"Space only"},{"value":"ascii","label":"ASCII","detail":"Greater-than signs"}],"style":"menu","mono":false}},{"id":"statusLine.contextLine","label":"Context-Reactive Line","hint":"How the line between the left and right segments reflects context usage (box composer only)","control":{"k":"choice","value":"embedded","options":[{"value":"off","label":"Off","detail":"Solid accent line, no context feedback"},{"value":"percentage","label":"Percentage","detail":"Used portion in accent color, remainder dimmed"},{"value":"annotated","label":"Annotated","detail":"Percentage plus ticks at the speculative and auto-compaction boundaries"},{"value":"embedded","label":"Embedded","detail":"Annotated line with the context percentage and window embedded in the gauge"}],"style":"menu","mono":false}},{"id":"statusLine.sessionAccent","label":"Session Accent","hint":"Use the session name color for the editor border and status line gap","control":{"k":"switch","on":true}},{"id":"statusLine.transparent","label":"Transparent Status Line","hint":"Use the terminal's default background for the status line instead of the theme's `statusLineBg`. Powerline end caps are dropped because they need a contrasting fill to bridge into the surrounding terminal.","control":{"k":"switch","on":false}},{"id":"statusLine.compactThinkingLevel","label":"Compact Thinking Level","hint":"Show the thinking level as a single icon on the model name instead of a separate ` · <level>` suffix; in Tern's composer, as the model chip's icon instead of a separate chip (click the icon to cycle it).","control":{"k":"switch","on":true}},{"id":"statusLine.showHookStatus","label":"Show Hook Status","hint":"Display hook status messages below the status line","control":{"k":"switch","on":true}}]},{"id":"display","title":"Display","rows":[{"id":"tui.resizeScrollback","label":"Resize Scrollback","hint":"How a settled terminal resize refreshes transcript rows retained in terminal scrollback","control":{"k":"choice","value":"rebuild","options":[{"value":"append","label":"Append","detail":"Replay the transcript at the new width below retained history"},{"value":"rebuild","label":"Rebuild","detail":"Erase all terminal scrollback, then replay one current-width transcript"},{"value":"preserve","label":"Preserve","detail":"Repaint only the viewport and keep history wrapped at its old width"}],"style":"menu","mono":false}},{"id":"terminal.showProgress","label":"Native Terminal Progress","hint":"Emit OSC 9;4 indeterminate progress while the agent or context maintenance is running (always on in Tern)","control":{"k":"switch","on":false}},{"id":"tui.textSizing","label":"Large Headings (Kitty)","hint":"Render Markdown H1 headings at 2x scale using Kitty's OSC 66 text-sizing protocol. Only takes effect on Kitty terminals; ignored everywhere else. Off by default.","control":{"k":"switch","on":false}},{"id":"tui.renderMermaid","label":"Render Mermaid Diagrams","hint":"Render Mermaid fenced code blocks as ASCII diagrams","control":{"k":"switch","on":true}},{"id":"tui.renderSvg","label":"Render SVG Figures","hint":"Invite the agent to draw diagrams and charts as SVG, rendered inline as images on terminals that show graphics","control":{"k":"switch","on":true}},{"id":"tui.autoGraph","label":"Auto-Graph Tables","hint":"Draw a chart under numeric tables in the agent's answers, in your theme's colors, on terminals that show graphics","control":{"k":"choice","value":"always","options":[{"value":"smart","label":"Smart","detail":"The judge model picks the chart kind and columns for tables with several numeric columns"},{"value":"always","label":"Always","detail":"Chart every table that reads as numeric, using the built-in best guess"},{"value":"off","label":"Off","detail":"Leave tables as tables"}],"style":"menu","mono":false}},{"id":"tui.reactions","label":"Agent Reactions","hint":"Invite the agent to react to your message with an emoji badge on its bubble","control":{"k":"switch","on":true}},{"id":"tui.codexResetFireworks","label":"Codex Reset Fireworks","hint":"Celebrate unscheduled Codex weekly usage resets and newly banked saved resets with a top-third fireworks overlay that remains until 󱊷","control":{"k":"switch","on":false}},{"id":"tui.titleState","label":"Terminal Title Run State","hint":"Show the agent run state in the terminal title's separator — an animated spinner while working (a static ':' under WSL), '>' when it's your turn, '!' when the agent is waiting on you","control":{"k":"switch","on":true}},{"id":"tui.titleSpinner","label":"Terminal Title Spinner","hint":"Glyph set for the working-state spinner in the terminal title — braille sweep, filling moon, single-dot cycle, or ASCII-safe line","control":{"k":"choice","value":"braille","options":[{"value":"braille","label":"Braille","detail":"Classic ⠋⠙⠹ sweep (default)"},{"value":"pulse","label":"Pulse","detail":"Moon filling ○◑● then emptying"},{"value":"dots","label":"Dots","detail":"Single braille dots cycling"},{"value":"line","label":"Line","detail":"ASCII - \\ | / for fonts without braille coverage"}],"style":"menu","mono":false}},{"id":"tui.hyperlinks","label":"Terminal Hyperlinks","hint":"Wrap paths and URLs in OSC 8 hyperlinks for terminal-native click-to-open (auto: detect support; off: never; always: unconditional)","control":{"k":"choice","value":"auto","options":[{"value":"off","label":"off"},{"value":"auto","label":"auto"},{"value":"always","label":"always"}]}},{"id":"tui.mouse","label":"Mouse Click-to-Focus","hint":"Capture mouse clicks in the main session so live subagent cards and HUD rows focus on click, with a hover highlight on the target. Native text selection becomes 󰘶+drag and wheel scroll becomes 󰘶+wheel while on","control":{"k":"switch","on":false}},{"id":"tui.tight","label":"Tight Layout","hint":"Remove the 1-character horizontal padding from the left and right of the terminal output","control":{"k":"switch","on":false}},{"id":"display.shimmer","label":"Shimmer","hint":"Animation style for working/loading messages","control":{"k":"choice","value":"classic","options":[{"value":"classic","label":"Classic","detail":"Soft cosine wave sweeping across the text"},{"value":"kitt","label":"KITT Scanner","detail":"Knight Rider 1982 red light bouncing left-right"},{"value":"disabled","label":"Disabled","detail":"No animation; static muted text"}],"style":"menu","mono":false}},{"id":"display.pinnedAgents","label":"Pinned Agents","hint":"Pinned live-agent jump list above the editor (off hides it; collapsed shows a few rows with an expander; full lists all)","control":{"k":"choice","value":"collapsed","options":[{"value":"off","label":"Off","detail":"Hide the pinned jump list"},{"value":"collapsed","label":"Collapsed","detail":"Show a few rows with an expander"},{"value":"full","label":"Full","detail":"Always list every live agent"}],"style":"menu","mono":false}},{"id":"display.subagentLivePreview","label":"Subagent Live Preview","hint":"Show each pinned subagent's current (or most recent) tool call beneath its row","control":{"k":"switch","on":false}},{"id":"display.smoothStreaming","label":"Smooth Streaming","hint":"Reveal assistant text and streamed tool input smoothly while chunks arrive","control":{"k":"switch","on":true}},{"id":"display.hideToolActivity","label":"Hide Tool Activity","hint":"Hide model-initiated tool calls and results from the transcript","control":{"k":"switch","on":false}},{"id":"display.showTokenUsage","label":"Show Token Usage","hint":"Show per-turn token usage on assistant messages","control":{"k":"switch","on":false}},{"id":"display.showTurnTime","label":"Show Turn Time","hint":"Show the total prompt-to-yield time (including tool calls) on assistant message usage rows","control":{"k":"switch","on":false}},{"id":"display.cacheMissMarker","label":"Cache Miss Marker","hint":"Show a divider after an assistant turn whose request lost (missed) the prompt cache","control":{"k":"switch","on":false}},{"id":"display.collapseCompacted","label":"Collapse Compacted History","hint":"Collapse pre-compaction history behind the summary divider on the live transcript; disable to keep the full transcript inline with dividers at each compaction point","control":{"k":"switch","on":true}},{"id":"showHardwareCursor","label":"Show Hardware Cursor","hint":"Show terminal cursor for IME support","control":{"k":"switch","on":true}},{"id":"tui.imeSafeCursor","label":"IME-Safe Prompt Layout","hint":"Move the prompt's bottom border to a separate row so macOS IME preedit cannot displace it","control":{"k":"switch","on":false}},{"id":"task.showResolvedModelBadge","label":"Show Resolved Model Badge","hint":"Display the actual model ID used by each subagent in the task widget status line","control":{"k":"switch","on":false}},{"id":"title.icons","label":"Title Icons","hint":"Icon and short code that head new generated session titles","control":{"k":"choice","value":"nf+emoji","options":[{"value":"nf+emoji","label":"Nerd Font + Emoji","detail":"Nerd Font glyph where the Nerd Font symbol preset renders it, else the emoji (default)"},{"value":"emoji","label":"Emoji","detail":"Always the emoji"},{"value":"boring","label":"Boring","detail":"Plain title: no icon or code"}],"style":"menu","mono":false}}]},{"id":"images","title":"Images","rows":[{"id":"terminal.showImages","label":"Show Inline Images","hint":"Render images inline in the terminal","control":{"k":"switch","on":true}},{"id":"images.autoResize","label":"Auto-Resize Images","hint":"Resize large images to 2000x2000 max for better model compatibility","control":{"k":"switch","on":true}},{"id":"images.blockImages","label":"Block Images","hint":"Prevent images from being sent to LLM providers","control":{"k":"switch","on":false}}]}],"focus":"theme.dark"},"c":[{"id":"v.status-preview","k":"col","p":{"role":"omp.prefs.preview.status"},"c":[{"id":"v.status-preview/bar","k":"status","p":{"role":"omp.status","transparent":false},"c":[{"id":"v.status-preview/bar/pi","k":"seg","p":{"role":"omp.status.pi","side":"left","priority":11,"spans":[],"icon":"omp","tone":"muted"}},{"id":"v.status-preview/bar/model","k":"seg","p":{"role":"omp.status.model","side":"left","priority":1009,"actions":{"click":"status.model"},"spans":[{"t":"Grok 4.7","s":"statusLineModel"},{"t":" · ","s":"dim"},{"t":"medium","s":"thinkingMedium"}],"icon":"model"}},{"id":"v.status-preview/bar/path","k":"seg","p":{"role":"omp.status.path","side":"left","priority":5,"min":{"w":"12ch"},"actions":{"click":"status.path"},"spans":[{"t":"…a94a-d692aa417101/scratchpad/prefs/","s":"statusLinePath dim"},{"t":"work","s":"statusLinePath strong"}],"icon":"scratch-folder"}},{"id":"v.status-preview/bar/context_pct","k":"seg","p":{"role":"omp.status.context_pct","side":"left","priority":1002,"actions":{"click":"status.context"},"spans":[{"t":"1.4%/500K","s":"statusLineContext"},{"t":"󰁨","s":"statusLineContext icon"}],"icon":"context"}},{"id":"v.status-preview/bar/cost","k":"seg","p":{"role":"omp.status.cost","side":"left","priority":1,"actions":{"click":"status.cost"},"spans":[{"t":"󰙺","s":"statusLineCost icon"}]}}]}]}]}],["del","3.^complete"],["focus",null]]}\_tsp;f;{"sf":"s:1","s":7,"ops":[["set","v",{"focus":"theme.light"}]]}\_tsp;f;{"sf":"s:1","s":8,"ops":[["set","v",{"focus":"symbolPreset"}]]}\_tsp;f;{"sf":"s:1","s":9,"ops":[["set","v",{"editing":{"row":"symbolPreset","option":"unicode"}}]]}\_tsp;f;{"sf":"s:1","s":10,"ops":[["set","v",{"editing":{"row":"symbolPreset","option":"nerd"}}]]}\_tsp;f;{"sf":"s:1","s":11,"ops":[["set","v",{"editing":null}]]}\_tsp;f;{"sf":"s:1","s":12,"ops":[["set","v",{"page":"shell","lead":"The bash tool and the eval runtimes.","sections":[{"id":"bash","title":"Bash","rows":[{"id":"bash.enabled","label":"Bash","hint":"Enable the bash tool for shell command execution","control":{"k":"switch","on":true}},{"id":"bash.allowCompoundCommands","label":"Allow Compound Commands","hint":"Evaluate literal && chains per command; unmatched commands use normal bash approval policy and mode","control":{"k":"switch","on":false}},{"id":"bash.autoBackground.enabled","label":"Bash Auto-Background","hint":"Automatically background long-running bash commands and deliver the result later","control":{"k":"switch","on":true}},{"id":"bashInterceptor.enabled","label":"Bash Interceptor","hint":"Block shell commands that have dedicated tools","control":{"k":"switch","on":false}},{"id":"bash.direnv","label":"direnv Auto-Load","hint":"Auto-load a repo's direnv/devenv `.envrc` into the bash session so devenv tools and env vars are present without manual `direnv exec`. Honors direnv's allow list: an `.envrc` you haven't `direnv allow`ed is never executed","control":{"k":"choice","value":"auto","options":[{"value":"auto","label":"auto"},{"value":"off","label":"off"}]}},{"id":"shellMinimizer.enabled","label":"Shell Minimizer","hint":"Compress verbose shell output (git, npm, cargo, etc.) before returning it to the agent","control":{"k":"switch","on":true}},{"id":"shellMinimizer.sourceOutlineLevel","label":"Shell Minimizer Source Outline","hint":"Source outline mode for cat/read of source files: default or aggressive","control":{"k":"choice","value":"default","options":[{"value":"default","label":"default"},{"value":"aggressive","label":"aggressive"}]}}]},{"id":"eval-runtimes","title":"Eval & Runtimes","rows":[{"id":"eval.py","label":"Python Eval Backend","hint":"Allow the eval tool to dispatch Python cells to the IPython kernel","control":{"k":"switch","on":true}},{"id":"eval.js","label":"JavaScript Eval Backend","hint":"Allow the eval tool to dispatch JavaScript cells to the in-process runtime","control":{"k":"switch","on":true}},{"id":"eval.autoProvision","label":"Eval Environment Provisioning","hint":"Automatically create the managed JavaScript eval package environment on first install","control":{"k":"switch","on":true}},{"id":"eval.tools.enabled","label":"Eval-Defined Tools","hint":"Let eval cells define tools (@tool in Python, tool(fn) in JS) that task, agent(), and workpool() subagents can call","control":{"k":"switch","on":true}},{"id":"eval.workpool.freshAgents","label":"Fresh Workpool Agents","hint":"Spawn a new subagent for every workpool item instead of reusing workers or batching queued items","control":{"k":"switch","on":false}},{"id":"eval.autoBackground.enabled","label":"Eval Auto-Background","hint":"Automatically background long-running eval cells and deliver the result later","control":{"k":"switch","on":false}},{"id":"python.kernelMode","label":"Python Kernel Mode","hint":"Keep the IPython kernel alive across eval calls or start fresh each time","control":{"k":"choice","value":"session","options":[{"value":"session","label":"session"},{"value":"per-call","label":"per-call"}]}},{"id":"python.interpreter","label":"Python Interpreter","hint":"Optional path to an exact Python executable. When set, automatic Python runtime discovery is skipped.","control":{"k":"text","value":""}}]}],"focus":"bash.enabled"}],["del","v.status-preview"]]}\_tsp;f;{"sf":"s:1","s":13,"ops":[["set","v",{"focus":"python.interpreter","editing":{"row":"python.interpreter","draft":"","cursor":0}}]]}\_tsp;f;{"sf":"s:1","s":14,"ops":[["set","v",{"editing":null}]]}\_tsp;f;{"sf":"s:1","s":15,"ops":[["del","v"],["focus","3.line/input"]]}\_tsp;x;{"id":"s:1","keep":true}\]0;π > work[?25h[?2026l[?7h[?1l>[?2004l[?5522l[?1006l[?1003l[?1000l[?2031l[<u[?2026l[?7h[?1l>[?2004l[?2031l[?2048l[?5522l[<u[>4;0m[?9001l[?1006l[?1003l[?1000l[0 q[?25h